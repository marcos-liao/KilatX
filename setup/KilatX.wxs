<?xml version="1.0" encoding="utf-8"?>
<!--
  KilatX MSI package (WiX Toolset 5), for companies that deploy software with Group Policy,
  Intune, SCCM and the like. Built by setup\build.ps1:
    wix build setup\KilatX.wxs -arch x64 -d Version=0.5.0 -d PayloadDir=<folder with KilatX.exe> -o KilatX-0.5.0-x64.msi

  Install / uninstall without questions:
    msiexec /i KilatX-0.5.0-x64.msi /qn
    msiexec /x KilatX-0.5.0-x64.msi /qn
  A newer MSI replaces an older one (major upgrade); settings and download lists stay.

  -d Test=1 builds "KilatX-Test" (own name, folder and upgrade code) for the test scripts.
-->
<?ifdef Test?>
  <?define Product = "KilatX-Test" ?>
  <?define UpgradeCode = "1AD0FB06-281C-42CF-B665-FE90F8ACAAA4" ?>
  <?define InnoKey = "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{02B69550-DBD6-419F-A029-44E057A0D633}_is1" ?>
<?else?>
  <?define Product = "KilatX" ?>
  <?define UpgradeCode = "25F0DEE2-B735-4852-AC72-518FAD253207" ?>
  <?define InnoKey = "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{6F7BF8B4-9806-4A82-AED0-B2E178DA5054}_is1" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.Product)" Manufacturer="KilatX" Version="$(var.Version)" UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="$(var.Product) $(var.Version)" Manufacturer="KilatX" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.Product) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="KilatX.ico" SourceFile="..\app\ui\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="KilatX.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/marcos-liao/KilatX" />
    <Property Id="ARPHELPLINK" Value="https://github.com/marcos-liao/KilatX/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- KilatX Setup (the .exe installer) and this package install to the same folder: one at a time. -->
    <Property Id="SETUPEXEINSTALLED">
      <RegistrySearch Id="SetupExeInstalled" Root="HKLM" Key="$(var.InnoKey)" Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT SETUPEXEINSTALLED"
            Message="$(var.Product) is already installed with KilatX Setup. Uninstall it first (Settings › Apps), then install this package." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.Product)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="$(var.Product)">
      <Component Id="KilatXExe" Directory="INSTALLFOLDER">
        <File Id="KilatXExe" Source="$(var.PayloadDir)\KilatX.exe" KeyPath="yes">
          <!-- The AppUserModelID keeps KilatX's name and icon on its notifications. -->
          <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="$(var.Product)" Description="KilatX"
                    WorkingDirectory="INSTALLFOLDER" Advertise="no">
            <ShortcutProperty Key="System.AppUserModel.ID" Value="KilatX.KilatX" />
          </Shortcut>
        </File>
        <!-- Written by KilatX.exe /register-machine; removed with the program. -->
        <RemoveFile Id="HostManifest" Name="app.kilatx.host.json" On="uninstall" />
        <!-- Tells KilatX Setup that this package owns the installation. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\$(var.Product)" Name="InstalledBy" Value="msi" Type="string" />
      </Component>
      <Component Id="License" Directory="INSTALLFOLDER">
        <File Id="License" Source="..\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="Notices" Directory="INSTALLFOLDER">
        <File Id="Notices" Source="..\app\docs\THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Before files are replaced or removed: KilatX of every signed-in user saves and exits, and
         whatever else runs from KilatX.exe (a browser's connection) is ended. Runs the copy that is
         there now; on a first install there is none, which is fine. -->
    <CustomAction Id="CloseKilatX" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]KilatX.exe&quot; /close &quot;[INSTALLFOLDER]KilatX.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Browsers of every user of the PC reach KilatX (companies often allow only this kind). -->
    <CustomAction Id="RegisterMachine" FileRef="KilatXExe" ExeCommand="/register-machine"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UnregisterMachine" FileRef="KilatXExe" ExeCommand="/unregister-machine"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseKilatX" After="InstallInitialize" />
      <Custom Action="UnregisterMachine" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterMachine" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
