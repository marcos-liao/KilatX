<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "exe": the two KilatX.exe built by .github/workflows/release.yml
     (x64 and arm64), signed before they go into the setups, MSIs and portable zips. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="x64/KilatX.exe" product-name="KilatX" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="arm64/KilatX.exe" product-name="KilatX" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
